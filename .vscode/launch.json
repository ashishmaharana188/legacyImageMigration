{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Chrome (Dev)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "userDataDir": "${workspaceFolder}/.vscode/vscode-chrome-debug-userdatadir"
    },
    {
      "name": "Launch Chrome (Prod)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5174",
      "webRoot": "${workspaceFolder}/frontend",
      "userDataDir": "${workspaceFolder}/.vscode/vscode-chrome-debug-userdatadir"
    },
    {
      "name": "Launch Helium (Dev)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "runtimeExecutable": "C:\\Users\\Ashish Maharana\\AppData\\Local\\imput\\Helium\\Application\\chrome.exe",
      "runtimeArgs": [
        "--remote-debugging-port=9222",
        "--no-first-run",
        "--no-default-browser-check",
        "--user-data-dir=${workspaceFolder}/.zed/helium-debug-profile"
      ],
      "userDataDir": false,
      "sourceMaps": true
    },
    {
      "name": "Launch Helium (Prod)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5174",
      "webRoot": "${workspaceFolder}/frontend",
      "runtimeExecutable": "C:\\Users\\Ashish Maharana\\AppData\\Local\\imput\\Helium\\Application\\chrome.exe",
      "runtimeArgs": [
        "--remote-debugging-port=9222",
        "--no-first-run",
        "--no-default-browser-check",
        "--user-data-dir=${workspaceFolder}/.zed/helium-debug-profile"
      ],
      "userDataDir": false,
      "sourceMaps": true
    },

    {
      "name": "Launch Chrome (Dev)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "userDataDir": "${workspaceFolder}/.vscode/vscode-chrome-debug-userdatadir"
    },
    {
      "name": "Launch Chrome (Prod)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5174",
      "webRoot": "${workspaceFolder}/frontend",
      "userDataDir": "${workspaceFolder}/.vscode/vscode-chrome-debug-userdatadir"
    },
    {
      "name": "Launch Firefox with Persistent Profile",
      "type": "firefox",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      // OPTION A: Points to a specific folder for this project
      "profileDir": "${workspaceFolder}/.vscode/firefox-profile",
      "keepProfileChanges": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
