{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Chrome (Dev)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "userDataDir": "${workspaceFolder}/.vscode/vscode-chrome-debug-userdatadir",
      "preLaunchTask": "Start Frontend DEV"
    },
    {
      "name": "Launch Chrome (PROD)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5174",
      "webRoot": "${workspaceFolder}/frontend",
      "userDataDir": "${workspaceFolder}/.vscode/vscode-chrome-debug-userdatadir",
      "preLaunchTask": "Start Frontend PROD"
    },
    {
      "name": "Launch Firefox DEV",
      "type": "firefox",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "profileDir": "${workspaceFolder}/.vscode/firefox-profile",
      "keepProfileChanges": true,
      "skipFiles": ["<node_internals>/**"],
      "preLaunchTask": "Start Frontend DEV"
    },
    {
      "name": "Launch Firefox PROD",
      "type": "firefox",
      "request": "launch",
      "url": "http://localhost:5174",
      "webRoot": "${workspaceFolder}",
      "profileDir": "${workspaceFolder}/.vscode/firefox-profile",
      "keepProfileChanges": true,
      "skipFiles": ["<node_internals>/**"],
      "preLaunchTask": "Start Frontend PROD"
    },
    {
      "name": "Backend: Node",
      "type": "node",
      "request": "launch",
      "args": ["backend/app.ts"],
      "runtimeArgs": ["-r", "ts-node/register"],
      "env": {
        // This forces ts-node to use your specific backend flags
        "TS_NODE_PROJECT": "${workspaceFolder}/backend/tsconfig.json",
        "TS_NODE_TRANSPILE_ONLY": "true"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Full System (Chrome)",
      "configurations": ["Launch Chrome (Dev)", "Backend: Node"],
      "stopAll": true
    },
    {
      "name": "Full System (Chrome)",
      "configurations": ["Launch Chrome (PROD)", "Backend: Node"],
      "stopAll": true
    },
    {
      "name": "Full System (Firefox)",
      "configurations": ["Launch Firefox DEV", "Backend: Node"],
      "stopAll": true
    },
    {
      "name": "Full System (Firefox)",
      "configurations": ["Launch Firefox PROD", "Backend: Node"],
      "stopAll": true
    }
  ]
}
